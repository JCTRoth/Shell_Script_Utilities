<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rclone Sync – LaunchAgent for macOS
  ====================================
  Install:
    cp rclone-sync.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/rclone-sync.plist

  Uninstall:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/rclone-sync.plist

  Manual trigger:
    launchctl kickstart gui/$(id -u)/local.rclone.sync

  View logs:
    tail -f ~/00_Sync/.rclone_sync.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.rclone.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jonas/00_Sync/setup_ryclone_headless.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jonas</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>7200</integer>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jonas/00_Sync/.rclone_sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jonas/00_Sync/.rclone_sync.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
